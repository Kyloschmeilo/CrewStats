<Project Sdk="Microsoft.NET.Sdk">

    <!-- Tests für die spielunabhängigen Regeln (RoundRules, RoundStats, Rundenformat, TorWishPicker) – laufen ohne Among Us und ohne BepInEx -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>CrewStats.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../CrewStats/RoundRules.cs" Link="RoundRules.cs" />
        <Compile Include="../CrewStats/RoundRecord.cs" Link="RoundRecord.cs" />
        <Compile Include="../CrewStats/RoundStats.cs" Link="RoundStats.cs" />
        <Compile Include="../CrewStats/TorWishPicker.cs" Link="TorWishPicker.cs" />
        <Compile Include="../CrewStats/AutoJoinRules.cs" Link="AutoJoinRules.cs" />
        <Compile Include="../CrewStats/PlayerInfoRules.cs" Link="PlayerInfoRules.cs" />
        <None Include="../docs/beispiel-runde.json" Link="beispiel-runde.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

</Project>
